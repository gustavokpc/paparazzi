<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">
<flight_plan alt="1.5" ground_alt="0" lat0="51.990634" lon0="4.376789" max_dist_from_home="60" name="Bebop RL CFC figure eight TU Delft Cyberzoo" security_height="0.4">

  <!--=== Header: module and Gazebo simulation world includes ===-->
  <header>
    #include "modules/datalink/datalink.h"
    #include "modules/energy/electrical.h"
    #include "modules/radio_control/radio_control.h"
    #include "modules/ahrs/ahrs.h"
    #define NPS_GAZEBO_WORLD "cyberzoo_rl_figure8.world"
    #include "autopilot.h"
    #include "modules/rl_cfc_control/rl_cfc_control.h"
    inline void setNav(void) {
      autopilot_mode_auto2 = AP_MODE_NAV;
      autopilot_static_set_mode(AP_MODE_NAV);
    }
    inline void setGuided(void) {
      autopilot_mode_auto2 = AP_MODE_GUIDED;
      autopilot_static_set_mode(AP_MODE_GUIDED);
    }
  </header>
  <waypoints>
    <waypoint lat="51.990631" lon="4.376796" name="HOME"/>
    <waypoint name="CLIMB" x="1.9" y="1.0" height="1.0"/>
    <waypoint name="STDBY" x="1.9" y="1.0" height="1.0"/>
    <waypoint name="TD" x="0.8" y="-1.7" height="0.5"/>
    <waypoint name="GOAL" x="1.9" y="1.0"/>
    <waypoint name="TRAJECTORY" x="1.9" y="1.0"/>
    <!-- RL figure-eight gates. Coordinates are Paparazzi ENU converted from RL [x,y,z_down] as [y,x,-z]. -->
    <waypoint name="RL_F8_1" x="-1.5" y="1.5" height="1.5"/>
    <waypoint name="RL_F8_2" x="0.0" y="0.0" height="1.5"/>
    <waypoint name="RL_F8_3" x="1.5" y="-1.5" height="1.5"/>
    <waypoint name="RL_F8_4" x="3.0" y="0.0" height="1.5"/>
    <waypoint name="RL_F8_5" x="1.5" y="1.5" height="1.5"/>
    <waypoint name="RL_F8_6" x="0.0" y="0.0" height="1.5"/>
    <waypoint name="RL_F8_7" x="-1.5" y="-1.5" height="1.5"/>
    <waypoint name="RL_F8_8" x="-3.0" y="0.0" height="1.5"/>
    <!-- Thin top-view rectangles used by PPRZ GCS to show each gate plane. -->
    <waypoint name="_G1A" x="-1.54" y="0.75"/><waypoint name="_G1B" x="-1.46" y="0.75"/>
    <waypoint name="_G1C" x="-1.46" y="2.25"/><waypoint name="_G1D" x="-1.54" y="2.25"/>
    <waypoint name="_G26A" x="-0.75" y="-0.04"/><waypoint name="_G26B" x="0.75" y="-0.04"/>
    <waypoint name="_G26C" x="0.75" y="0.04"/><waypoint name="_G26D" x="-0.75" y="0.04"/>
    <waypoint name="_G3A" x="1.46" y="-2.25"/><waypoint name="_G3B" x="1.54" y="-2.25"/>
    <waypoint name="_G3C" x="1.54" y="-0.75"/><waypoint name="_G3D" x="1.46" y="-0.75"/>
    <waypoint name="_G4A" x="2.25" y="-0.04"/><waypoint name="_G4B" x="3.75" y="-0.04"/>
    <waypoint name="_G4C" x="3.75" y="0.04"/><waypoint name="_G4D" x="2.25" y="0.04"/>
    <waypoint name="_G5A" x="1.46" y="0.75"/><waypoint name="_G5B" x="1.54" y="0.75"/>
    <waypoint name="_G5C" x="1.54" y="2.25"/><waypoint name="_G5D" x="1.46" y="2.25"/>
    <waypoint name="_G7A" x="-1.54" y="-2.25"/><waypoint name="_G7B" x="-1.46" y="-2.25"/>
    <waypoint name="_G7C" x="-1.46" y="-0.75"/><waypoint name="_G7D" x="-1.54" y="-0.75"/>
    <waypoint name="_G8A" x="-3.75" y="-0.04"/><waypoint name="_G8B" x="-2.25" y="-0.04"/>
    <waypoint name="_G8C" x="-2.25" y="0.04"/><waypoint name="_G8D" x="-3.75" y="0.04"/>
    <waypoint lat="51.9905834" lon="4.3767710" name="_CZ1"/>
    <waypoint lat="51.9906440" lon="4.3767060" name="_CZ2"/>
    <waypoint lat="51.9906860" lon="4.3768080" name="_CZ3"/>
    <waypoint lat="51.9906238" lon="4.3768729" name="_CZ4"/>
    <waypoint lat="51.9906006" lon="4.3767764" name="_OZ1"/>
    <waypoint lat="51.9906405" lon="4.3767316" name="_OZ2"/>
    <waypoint lat="51.9906687" lon="4.3768025" name="_OZ3"/>
    <waypoint lat="51.9906273" lon="4.3768438" name="_OZ4"/>
  </waypoints>

  <!--=== Sectors: define geofence regions ===-->
  <sectors>
    <!-- Gate planes (1.5 m opening). Gates 2 and 6 share one physical gate. -->
    <sector color="#00BFFF" name="GATE_1"><corner name="_G1A"/><corner name="_G1B"/><corner name="_G1C"/><corner name="_G1D"/></sector>
    <sector color="#00BFFF" name="GATE_2_6"><corner name="_G26A"/><corner name="_G26B"/><corner name="_G26C"/><corner name="_G26D"/></sector>
    <sector color="#00BFFF" name="GATE_3"><corner name="_G3A"/><corner name="_G3B"/><corner name="_G3C"/><corner name="_G3D"/></sector>
    <sector color="#00BFFF" name="GATE_4"><corner name="_G4A"/><corner name="_G4B"/><corner name="_G4C"/><corner name="_G4D"/></sector>
    <sector color="#00BFFF" name="GATE_5"><corner name="_G5A"/><corner name="_G5B"/><corner name="_G5C"/><corner name="_G5D"/></sector>
    <sector color="#00BFFF" name="GATE_7"><corner name="_G7A"/><corner name="_G7B"/><corner name="_G7C"/><corner name="_G7D"/></sector>
    <sector color="#00BFFF" name="GATE_8"><corner name="_G8A"/><corner name="_G8B"/><corner name="_G8C"/><corner name="_G8D"/></sector>

    <!-- Outer geofence (hard stop, Cyberzoo walls) -->
    <sector color="red" name="CyberZoo">
      <corner name="_CZ1"/>
      <corner name="_CZ2"/>
      <corner name="_CZ3"/>
      <corner name="_CZ4"/>
    </sector>

    <!-- Inner geofence (soft stop, obstacle zone) -->
    <sector color="#FF9922" name="ObstacleZone">
      <corner name="_OZ1"/>
      <corner name="_OZ2"/>
      <corner name="_OZ3"/>
      <corner name="_OZ4"/>
    </sector>
  </sectors>

  <!--=== Exceptions: handle emergencies and geofencing ===-->
  <exceptions>
    <!-- RC lost -->
    <!--exception cond="((radio_control.status == RC_REALLY_LOST) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="Standby"/-->
    <!-- Datalink lost (constant RPM descent) -->
    <exception cond="((datalink_time @GT 5) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="land here"/>
    <!-- Geofencing XY -->
    <exception cond="(!InsideCyberZoo(GetPosX(), GetPosY()) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="land here"/>
    <!-- Geofencing Z 2.5 -->
    <exception cond="((GetPosAlt() @GT 3.5) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="land here"/>
    <!-- Geofencing Z 4.5 (constant RPM descent)-->
    <exception cond="((GetPosAlt() @GT 4.5) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      (autopilot_in_flight() == true) )" deroute="Landed"/>
    <!-- Bat low -->
    <exception cond="(electrical.bat_low @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="land here"/>
    <!-- Bat critical (constant RPM no stabilization)-->
    <exception cond="(electrical.bat_critical @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('land here')) @AND
      (autopilot_in_flight() == true) )" deroute="land here"/>
  </exceptions>

  <!--=== Blocks: define mission workflow ===-->
  <blocks>
    <block name="Wait GPS">
      <call_once fun="NavKillThrottle()"/>
      <while cond="!GpsFixValid()"/>
    </block>

    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 2)"/>
      <call_once fun="NavSetAltitudeReferenceHere()"/>
    </block>

    <block name="Holding point">
      <call_once fun="rl_cfc_control_stop()"/>
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>

    <block key="r" name="Start Engine">
      <call_once fun="NavResurrect()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
      <call_once fun="NavResurrect()"/>
    </block>

    <block key="t" name="Takeoff" strip_button="Takeoff" strip_icon="takeoff.png">
      <call_once fun="NavSetWaypointHere(WP_TD)"/> 
      <exception cond="GetPosAlt() @GT 0.8" deroute="Standby"/>
      <call_once fun="NavSetWaypointHere(WP_CLIMB)"/>
      <stay climb="nav.climb_vspeed" vmode="climb" wp="CLIMB"/>
    </block>

    <block key="s" name="Standby" strip_button="Standby" strip_icon="home.png">
      <call_once fun="NavSetWaypointHere(WP_STDBY)"/>
      <stay wp="STDBY"/>
    </block>

    <block key="g" name="RL CFC figure eight" strip_button="RL CFC 8" strip_icon="lookfore.png">
      <call_once fun="setGuided()"/>
      <call_once fun="rl_cfc_control_start()"/>
      <stay wp="STDBY"/>
    </block>

    <block name="STOP">
      <call_once fun="rl_cfc_control_stop()"/>
      <call_once fun="NavSetWaypointHere(WP_STDBY)"/>
      <call_once fun="setNav()"/>
      <stay wp="STDBY"/>
    </block>
    
    <block key="e" name="Emergency Landing">
      <exception cond="!nav_is_in_flight()" deroute="KILL"/>
      <exception cond="0.10 @GT GetPosAlt()" deroute="KILL"/>
      <call_once fun="rl_cfc_control_stop()"/>
      <call_once fun="setNav()"/>
      <call_once fun="NavSetWaypointHere(WP_TD)"/>
      <call_once fun="NavStartDetectGround()"/>
      <stay climb="-1.25" vmode="climb" wp="TD"/>
    </block>

    <block key="l" name="land here" strip_button="Land Here" strip_icon="land-right.png">
      <call_once fun="rl_cfc_control_stop()"/>
      <call_once fun="setNav()"/>
      <call_once fun="NavSetWaypointHere(WP_TD)"/>
      <go wp="TD"/>
      <deroute block="Flare"/>
    </block>
    <block name="Land">
      <exception cond="0.55 @GEQ GetPosAlt()" deroute="Flare"/>
      <exception cond="block_time @GT 5" deroute="Flare"/>
      <call_once fun="rl_cfc_control_stop()"/>
      <call_once fun="setNav()"/>
      <go wp="TD"/>
      <deroute block="Flare"/>
    </block>

    <block name="Flare">
      <call_once fun="rl_cfc_control_stop()"/>
      <call_once fun="setNav()"/>
      <call_once fun="NavSetWaypointHere(WP_TD)"/>
      <call_once fun="NavStartDetectGround()"/>
      <exception cond="NavDetectGround()" deroute="Holding point"/>
      <exception cond="!nav_is_in_flight()" deroute="Landed"/>
      <exception cond="0.10 @GT GetPosAlt()" deroute="Landed"/>
      <stay climb="-0.30" vmode="climb" wp="TD" until="GetPosAlt() @LT 0.45"/>
      <stay climb="-0.15" vmode="climb" wp="TD"/>
    </block>

    <block name="Landed">
      <call_once fun="rl_cfc_control_stop()"/>
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>

    <block name="KILL">
      <call_once fun="rl_cfc_control_stop()"/>
      <call_once fun="autopilot_set_mode(AP_MODE_KILL)"/>
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
  </blocks>
</flight_plan>
