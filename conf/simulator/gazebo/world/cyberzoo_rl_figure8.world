    <include>
      <uri>model://rl_figure8_gate</uri>
      <name>rl_f8_gate_4</name>
      <pose>3.0 0 1.5 0 0 0</pose>
    </include>
    <include>
      <uri>model://rl_figure8_gate</uri>
      <name>rl_f8_gate_5</name>
      <pose>1.5 1.5 1.5 0 0 1.570796327</pose>
    </include>
    <include>
      <uri>model://rl_figure8_gate</uri>
      <name>rl_f8_gate_7</name>
